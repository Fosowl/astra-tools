{
  "$defs": {
    "AnalysisContent": {
      "additionalProperties": false,
      "description": "The content of an analysis specification.",
      "properties": {
        "name": {
          "description": "Human-readable name for the analysis",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Detailed description of the analysis",
          "title": "Description"
        },
        "authors": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of authors",
          "title": "Authors"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tags for categorization",
          "title": "Tags"
        },
        "problem": {
          "description": "Problem statement describing what the analysis aims to achieve",
          "title": "Problem",
          "type": "string"
        },
        "success_criteria": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Concrete criteria for determining if the analysis succeeded. Each criterion should be specific and verifiable.",
          "title": "Success Criteria"
        },
        "inputs": {
          "description": "List of inputs for the analysis",
          "items": {
            "$ref": "#/$defs/Input"
          },
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "description": "List of expected outputs",
          "items": {
            "$ref": "#/$defs/Output"
          },
          "title": "Outputs",
          "type": "array"
        }
      },
      "required": [
        "name",
        "problem",
        "inputs",
        "outputs"
      ],
      "title": "AnalysisContent",
      "type": "object"
    },
    "Artefact": {
      "additionalProperties": false,
      "description": "An artefact produced by a chunk.",
      "properties": {
        "id": {
          "description": "Unique identifier for the artefact",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "description": "Type of artefact",
          "enum": [
            "figure",
            "table",
            "data",
            "report"
          ],
          "title": "Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Relative path for result file within results directory",
          "title": "Path"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Description of the artefact",
          "title": "Description"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Artefact",
      "type": "object"
    },
    "Checksum": {
      "additionalProperties": false,
      "description": "Checksum for data integrity verification.",
      "properties": {
        "algorithm": {
          "description": "Hash algorithm",
          "enum": [
            "sha256",
            "sha512",
            "md5"
          ],
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "description": "Hash value",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "title": "Checksum",
      "type": "object"
    },
    "Chunk": {
      "additionalProperties": false,
      "description": "An inline chunk within an analysis \u2014 a scoped stage with its own problem,\ndecisions, and optional artefacts.",
      "properties": {
        "problem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Problem statement for this chunk (optional for 'main' chunk, which inherits from analysis)",
          "title": "Problem"
        },
        "success_criteria": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Concrete criteria for determining if this chunk succeeded.",
          "title": "Success Criteria"
        },
        "decisions": {
          "additionalProperties": {
            "$ref": "#/$defs/Decision"
          },
          "description": "Map of decision IDs to decision specifications scoped to this chunk",
          "title": "Decisions",
          "type": "object"
        },
        "artefacts": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Artefact"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of artefacts produced by this chunk",
          "title": "Artefacts"
        }
      },
      "title": "Chunk",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "A decision point in the analysis.",
      "properties": {
        "label": {
          "description": "Human-readable name for the decision",
          "title": "Label",
          "type": "string"
        },
        "type": {
          "description": "Category of decision",
          "enum": [
            "data",
            "method",
            "parameter"
          ],
          "title": "Type",
          "type": "string"
        },
        "importance": {
          "default": 3,
          "description": "Importance level (1=critical, 5=implementation detail)",
          "maximum": 5,
          "minimum": 1,
          "title": "Importance",
          "type": "integer"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why this decision exists",
          "title": "Rationale"
        },
        "reviewed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whether a human has reviewed and confirmed this decision",
          "title": "Reviewed"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default option ID for baseline universes",
          "title": "Default"
        },
        "options": {
          "additionalProperties": {
            "$ref": "#/$defs/Option"
          },
          "description": "Map of option IDs to option specifications",
          "title": "Options",
          "type": "object"
        }
      },
      "required": [
        "label",
        "type",
        "options"
      ],
      "title": "Decision",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Evidence from scientific literature with W3C-compliant selectors.\n\nReferences papers directly by DOI. At least one content selector\n(quote, figure, or table) is required. The FragmentSelector provides\noptional PDF location hints.\n\nFor arXiv papers, the DOI format is: 10.48550/arXiv.{id}\nThe version field is used for arXiv papers where version matters.",
      "properties": {
        "id": {
          "description": "Evidence ID",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "doi": {
          "description": "DOI of the source paper (e.g., '10.48550/arXiv.1706.03762')",
          "pattern": "^10\\.\\d{4,}/.*$",
          "title": "Doi",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Paper version for arXiv papers (version matters for reproducibility)",
          "title": "Version"
        },
        "quote": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextQuoteSelector"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text quote anchor"
        },
        "figure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FigureSelector"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Figure reference"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableSelector"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Table reference"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/FragmentSelector"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PDF location hint"
        }
      },
      "required": [
        "id",
        "doi"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FigureSelector": {
      "additionalProperties": false,
      "description": "Selector for referencing figures in scientific papers.\n\nExtension of W3C selector pattern for scientific literature.\nThe label is the authoritative identifier (e.g., \"Figure 3a\").",
      "properties": {
        "type": {
          "const": "FigureSelector",
          "default": "FigureSelector",
          "title": "Type",
          "type": "string"
        },
        "label": {
          "description": "Figure label (e.g., 'Figure 3a', 'Fig. 1')",
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Caption text for verification",
          "title": "Caption"
        }
      },
      "required": [
        "label"
      ],
      "title": "FigureSelector",
      "type": "object"
    },
    "FragmentSelector": {
      "additionalProperties": false,
      "description": "W3C FragmentSelector for PDF locations.\n\nSee: https://www.w3.org/TR/annotation-model/#fragment-selector\nConforms to RFC 3778/8118 for PDF fragments.",
      "properties": {
        "type": {
          "const": "FragmentSelector",
          "default": "FragmentSelector",
          "title": "Type",
          "type": "string"
        },
        "conformsTo": {
          "const": "http://tools.ietf.org/rfc/rfc3778",
          "default": "http://tools.ietf.org/rfc/rfc3778",
          "title": "Conformsto",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fragment (e.g., 'page=6')",
          "title": "Value"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-indexed page number",
          "title": "Page"
        }
      },
      "title": "FragmentSelector",
      "type": "object"
    },
    "Input": {
      "additionalProperties": false,
      "description": "An input to the analysis.",
      "properties": {
        "id": {
          "description": "Unique identifier for the input",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "description": "Type of input",
          "enum": [
            "data",
            "analysis",
            "literature"
          ],
          "title": "Type",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source specification for the input",
          "title": "Source"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference to another analysis (for type: analysis)",
          "title": "Ref"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version of the referenced analysis",
          "title": "Version"
        },
        "use_outputs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Specific outputs to use from referenced analysis",
          "title": "Use Outputs"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Description of the input",
          "title": "Description"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Input",
      "type": "object"
    },
    "Insight": {
      "additionalProperties": false,
      "description": "A scientific insight with provenance and supporting evidence.\n\nRepresents a discrete unit of scientific knowledge extracted from\nliterature, with full traceability to source material via W3C-compliant\ntext selectors. Evidence directly references papers by DOI.",
      "properties": {
        "id": {
          "description": "Unique identifier",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "claim": {
          "description": "What we learned (1-2 sentences)",
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "created_at": {
          "description": "Creation timestamp (ISO 8601)",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence": {
          "description": "Supporting evidence",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Confidence [0,1]",
          "title": "Confidence"
        },
        "derived": {
          "default": false,
          "description": "True if synthesized/inferred",
          "title": "Derived",
          "type": "boolean"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Applicability conditions",
          "title": "Scope"
        },
        "tags": {
          "description": "Categorization tags",
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reasoning notes",
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "claim",
        "created_at",
        "evidence"
      ],
      "title": "Insight",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "description": "An option for a decision.",
      "properties": {
        "label": {
          "description": "Human-readable name for the option",
          "title": "Label",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Detailed description of the option",
          "title": "Description"
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Configuration value for this option",
          "title": "Value"
        },
        "insights": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of insight IDs supporting this option",
          "title": "Insights"
        },
        "incompatible_with": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of decision.option pairs that cannot be selected together",
          "title": "Incompatible With"
        },
        "requires": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "List of decision.option pairs that must also be selected",
          "title": "Requires"
        }
      },
      "required": [
        "label"
      ],
      "title": "Option",
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "description": "An expected output from the analysis.",
      "properties": {
        "id": {
          "description": "Unique identifier for the output",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "description": "Type of output",
          "enum": [
            "metric",
            "figure",
            "table",
            "data",
            "model",
            "report"
          ],
          "title": "Type",
          "type": "string"
        },
        "dtype": {
          "anyOf": [
            {
              "enum": [
                "float",
                "int",
                "bool",
                "string"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Data type for metrics",
          "title": "Dtype"
        },
        "range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Valid range for numeric metrics [min, max]",
          "title": "Range"
        },
        "formats": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Supported file formats for artifacts",
          "title": "Formats"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Relative path for result file within results directory",
          "title": "Path"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Description of the output",
          "title": "Description"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Output",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Source specification for inputs.",
      "properties": {
        "type": {
          "description": "Type of source",
          "enum": [
            "url",
            "s3",
            "sklearn",
            "asp",
            "file"
          ],
          "title": "Type",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "URL for url type sources",
          "title": "Url"
        },
        "bucket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "S3 bucket name",
          "title": "Bucket"
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "S3 object key",
          "title": "Key"
        },
        "version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "S3 version ID",
          "title": "Version Id"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "AWS region",
          "title": "Region"
        },
        "dataset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "sklearn dataset name",
          "title": "Dataset"
        },
        "analysis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ASP analysis reference",
          "title": "Analysis"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version of referenced analysis",
          "title": "Version"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Output ID from referenced analysis",
          "title": "Output"
        },
        "execution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Specific execution ID",
          "title": "Execution"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Local file path",
          "title": "Path"
        },
        "checksum": {
          "anyOf": [
            {
              "$ref": "#/$defs/Checksum"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Checksum for verification"
        }
      },
      "required": [
        "type"
      ],
      "title": "Source",
      "type": "object"
    },
    "TableSelector": {
      "additionalProperties": false,
      "description": "Selector for referencing tables in scientific papers.\n\nExtension of W3C selector pattern for scientific literature.\nThe label is the authoritative identifier (e.g., \"Table 2\").",
      "properties": {
        "type": {
          "const": "TableSelector",
          "default": "TableSelector",
          "title": "Type",
          "type": "string"
        },
        "label": {
          "description": "Table label (e.g., 'Table 1', 'Tab. 2')",
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Caption/header text for verification",
          "title": "Caption"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Specific region (e.g., 'row 3')",
          "title": "Region"
        }
      },
      "required": [
        "label"
      ],
      "title": "TableSelector",
      "type": "object"
    },
    "TextQuoteSelector": {
      "additionalProperties": false,
      "description": "W3C TextQuoteSelector for locating text in a document.\n\nSee: https://www.w3.org/TR/annotation-model/#text-quote-selector\n\nThe authoritative anchor for verification. Text should be normalized\n(HTML/XML tags removed, entities decoded).",
      "properties": {
        "type": {
          "const": "TextQuoteSelector",
          "default": "TextQuoteSelector",
          "title": "Type",
          "type": "string"
        },
        "exact": {
          "description": "Exact quoted text (1-3 sentences)",
          "minLength": 1,
          "title": "Exact",
          "type": "string"
        },
        "prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "~20-100 chars before for disambiguation",
          "title": "Prefix"
        },
        "suffix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "~20-100 chars after for disambiguation",
          "title": "Suffix"
        }
      },
      "required": [
        "exact"
      ],
      "title": "TextQuoteSelector",
      "type": "object"
    }
  },
  "$id": "https://asp-spec.org/v1/analysis.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Complete ASP analysis specification.",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
